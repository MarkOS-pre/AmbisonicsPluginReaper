@init

/* filtro_shelving_W: función que calcula los coeficientes del filtro shelving para el canal W */

function filtro_shelving_W(fc, dBgain)
(
  A  = 10^(dBgain/40);
  w0 = 2*$pi*fc/srate;
  S  = 1;

  alpha = sin(w0)/2 * sqrt((A + 1/A)*(1/S - 1) + 2);
  cosw = cos(w0);

  //Definición de coeficientes
  b0 =    A*((A+1) + (A-1)*cosw + 2*sqrt(A)*alpha);
  b1 =  -2*A*((A-1) + (A+1)*cosw);
  b2 =    A*((A+1) + (A-1)*cosw - 2*sqrt(A)*alpha);
  a0 =        (A+1) - (A-1)*cosw + 2*sqrt(A)*alpha;
  a1 =   2*((A-1) - (A+1)*cosw);
  a2 =        (A+1) - (A-1)*cosw - 2*sqrt(A)*alpha;

  // Coeficientes normalizados
  B0w = b0/a0; 
  B1w = b1/a0; 
  B2w = b2/a0;
  A1w = a1/a0; 
  A2w = a2/a0;

  // inicializacion de variables de estado
	x1w=0; x2w=0; y1w=0; y2w=0;
 
);

/* filtro_shelving_XYZ: función que calcula los coeficientes del filtro shelving para los canales XYZ */

function filtro_shelving_XYZ(fc, dBgain)
(
  A  = 10^(dBgain/40);
  w0 = 2*$pi*fc/srate;
  S  = 1;

  alpha = sin(w0)/2 * sqrt((A + 1/A)*(1/S - 1) + 2);
  cosw = cos(w0);

  //Definición de coeficientes
  b0 =    A*((A+1) + (A-1)*cosw + 2*sqrt(A)*alpha);
  b1 =  -2*A*((A-1) + (A+1)*cosw);
  b2 =    A*((A+1) + (A-1)*cosw - 2*sqrt(A)*alpha);
  a0 =        (A+1) - (A-1)*cosw + 2*sqrt(A)*alpha;
  a1 =   2*((A-1) - (A+1)*cosw);
  a2 =        (A+1) - (A-1)*cosw - 2*sqrt(A)*alpha;

  // Coeficientes normalizados
  B0xyz = b0/a0; 
  B1xyz = b1/a0; 
  B2xyz = b2/a0;
  A1xyz = a1/a0; 
  A2xyz = a2/a0;

  // inicializacion de variables de estado
  x1_X=0; x2_X=0; y1_X=0; y2_X=0;
  x1_Y=0; x2_Y=0; y1_Y=0; y2_Y=0;
  x1_Z=0; x2_Z=0; y1_Z=0; y2_Z=0;
  
);

/* función aplicar_filtro_W: función que aplica el filtro shelving al canal W */
function aplicar_filtro_W(x0_W)
(
	y0_W = B0w*x0_W + B1w*x1w + B2w*x2w - A1w*y1w - A2w*y2w;
	x2w=x1w; x1w=x0_W; y2w=y1w; y1w=y0_W;

	y0_W  // valor de retorno
);

/* función aplicar_filtro_X: función que aplica el filtro shelving al canal X */
function aplicar_filtro_X(x0_X)
(
  y0_X = B0xyz*x0_X + B1xyz*x1_X + B2xyz*x2_X - A1xyz*y1_X - A2xyz*y2_X;
  x2_X=x1_X; x1_X=x0_X; y2_X=y1_X; y1_X=y0_X;

  y0_X  //valor de retorno
);

/* función aplicar_filtro_Y: función que aplica el filtro shelving al canal Y */
function aplicar_filtro_Y(x0_Y)
(
  y0_Y = B0xyz*x0_Y + B1xyz*x1_Y + B2xyz*x2_Y - A1xyz*y1_Y - A2xyz*y2_Y;
  x2_Y=x1_Y; x1_Y=x0_Y; y2_Y=y1_Y; y1_Y=y0_Y;

  y0_Y  //valor de retorno
);

/* función aplicar_filtro_Z: función que aplica el filtro shelving al canal Z */
function aplicar_filtro_Z(x0_Z)
(
  y0_Z = B0xyz*x0_Z + B1xyz*x1_Z + B2xyz*x2_Z - A1xyz*y1_Z - A2xyz*y2_Z;
  x2_Z=x1_Z; x1_Z=x0_Z; y2_Z=y1_Z; y1_Z=y0_Z;

  y0_Z  //valor de retorno
);