@init

/* Función inicializarBuffers: Configura los parámetros y buffers necesarios para la biauralización */

function inicializarBuffers() (

	kernelSize = 256;   //256 pares complejos
	fftSize = 512; //doble del kernelSize, 512 pares complejos
	bufferPosition = 0; //Posicion acutal dentro del buffer de audio

	// muestrasNuevas es el número de muestras nuevas que procesamos por bloque
	// Es el tamaño FFT menos el kernel menos 1 (requisito del overlap-add)
	muestrasNuevas = fftSize - kernelSize - 1; //Numero de muestras nuevas que se añaden al kernel 
	muestrasNuevas2 = muestrasNuevas *2; //Doble de muestras nuevas 
	
	//Buffers de 65536 posiciones para no solaparse entre ellos
	impulseBufferL = 65536 *1;
	impulseBufferR= 65536 *2;

	//Buffers para almacenar las muestras transformadas con FFt
	kernelBufferL = 65536 *3;
	kernelBufferR = 65536 *4;

	//Buffers de audio para lamacenar la convolución por bloques
	blockCurrentBufferL = 65536 *5;
	blockCurrentBufferR = 65536 *6;
	blockNextBufferL = 65536 *7;
	blockNextBufferR = 65536 *8;

	//Inicializar el contenido de los buffers a cero para evitar contenido basura que se haya quedado de ejecuciones anteriores o de la memoria
	memset(blockCurrentBufferL,  0, fftSize * 2); 
	memset(blockCurrentBufferR,  0, fftSize * 2);
	memset(blockNextBufferL, 0, fftSize * 2);
	memset(blockNextBufferR, 0, fftSize * 2);

);

/* Función cargarFicherosWAV: Carga los archivos WAV de las respuestas al impulso (HRIR) para los canales izquierdo y derecho en los buffers correspondientes */

function cargarFicherosWAV() (
	
	//Leer HRIR_L

	fh = file_open("/AudioHRTF/HRIR_L.wav");
	fh >0 ? (
		file_riff(fh, fh_nch, fh_srate);           //Lee cabecera para obener numero de canales y frecuencia de muestreo del archivo
		nSamples = file_avail(fh);                 //Numero total de muestras del archivo wav
		file_mem(fh, impulseBufferL, nSamples);    //Carga el archivo wav en el buffer de impulsos W
		file_close(fh);
	);

	//Leer HRIR_R
	fh = file_open("/AudioHRTF/HRIR_R.wav");
	fh >0 ? (
		file_riff(fh, fh_nch, fh_srate);
		nSamples = file_avail(fh);
		file_mem(fh, impulseBufferR, nSamples);
		file_close(fh);
	);	
);

/* Función prepararKernelsFFT: Prepara los kernels de convolución para los canales izquierdo y derecho aplicando la FFT a las respuestas al impulso */

function prepararKernelsFFT() (

		//Preparar kernel L
		//1. Copia el impulso al buffer del kernel (256*2 valores, son pares complejos)
		memcpy(kernelBufferL, impulseBufferL, kernelSize *2); 
		//2. Rellenar el resto del buffer del kernel con ceros (512 valores de ceros)
		memset(kernelBufferL + kernelSize *2, 0, kernelSize *2);
		//3. Aplicar FFT al kernel para obtener su representación en frecuencia
		fft(kernelBufferL, fftSize);
		//4. Normalizar dividiendo por el tamaño de la FFT
		i = 0;
		loop(2*fftSize,
			kernelBufferL[i] = kernelBufferL[i] / fftSize;
			i += 1;
		);
		

		//Preparar kernel R
		memcpy(kernelBufferR, impulseBufferR, kernelSize *2);
		memset(kernelBufferR + kernelSize *2, 0, kernelSize *2);
		fft(kernelBufferR, fftSize);
		i = 0;
		loop(2*fftSize,
			kernelBufferR[i] = kernelBufferR[i] / fftSize;
			i += 1;
		);
		

		bufferPosition = 0; //Reiniciar la posición del buffer de audio para empezar a procesar desde el principio
	);

	/* Función convolucionarBloqueFFT: Realiza la convolución por bloques utilizando la FFT para los canales izquierdo y derecho, y sincroniza el resto de canales del proyecto con el canal convolucionado */

	function convolucionarBloqueFFT() (
		// ---- canal L
		// Intercambia los buffers: el bloque anterior pasa a ser el actual
		tempBlock = blockNextBufferL;
		blockNextBufferL = blockCurrentBufferL;
		blockCurrentBufferL = tempBlock;
		
		//Rellena cola con zeros (zero-padding) para evitar el solapamiento circular.
		//Desde la posición de las nuevas muestras (250 pares, 510 muestras) hasta el 
		//final del bloque se añaden 514 muestras de ceros ya que la convolucion va a 
		//rellenar con 1024 muestras y asi evitar solapmiento circular.
		memset(blockCurrentBufferL + muestrasNuevas*2, 0 , (fftSize - muestrasNuevas)*2); 

		//Convoluciona: FFt del bloque actual, multiplicación punto a punto con el kernel en frecuencia, IFFT para obtener el bloque convolucionado en tiempo
		fft(blockCurrentBufferL, fftSize); //FFT del bloque actual
		convolve_c(blockCurrentBufferL, kernelBufferL, fftSize); //Multiplicación punto a punto en frecuencia
		ifft(blockCurrentBufferL, fftSize); //IFFT para obtener el bloque convolucionado en tiempo

		//---- Canal R
		tempBlock = blockNextBufferR;
		blockNextBufferR = blockCurrentBufferR;
		blockCurrentBufferR = tempBlock;

		memset(blockCurrentBufferR + muestrasNuevas*2, 0 , (fftSize - muestrasNuevas)*2);
		fft(blockCurrentBufferR, fftSize);
		convolve_c(blockCurrentBufferR, kernelBufferR, fftSize);
		ifft(blockCurrentBufferR, fftSize);

		//Retarda el resto de canales del proyecto para sincronizarlos con el canal convolucionado, ya que la FFT introduce un retardo de procesamiento.
		pdc_delay = ((1.5*kernelSize) | 0) -2; //Calcula el retardo de procesamiento como el tamaño del kernel más un margen de seguridad (1.5 veces el tamaño del kernel) para evitar problemas de solapamiento, redondeado hacia abajo y restando 2 muestras para compensar el retraso introducido por la FFT
		pdc_bot_ch = 0;
		pdc_top_ch = 2;

		bufferPosition = 0;
	);

	

